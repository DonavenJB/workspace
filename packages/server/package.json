{
  "name": "@empiryu/server",
  "version": "0.0.0",
  "private": true,
  "description": "Empiryu game server — NestJS on the Fastify adapter. The authority.",
  "type": "module",
  "scripts": {
    "dev": "node --watch --import ./loader.mjs src/main.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/main.js",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@nestjs/common": "^10.4.0",
    "@nestjs/core": "^10.4.0",
    "@nestjs/platform-fastify": "^10.4.0",
    "@empiryu/shared": "*",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1"
  },
  "devDependencies": {
    "@types/node": "^20.14.0",
    "ts-node": "^10.9.2",
    "typescript": "^5.6.0"
  }
}
